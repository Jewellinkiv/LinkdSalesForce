DATABASE_URL=postgres://linkd:local-development-only@127.0.0.1:55438/linkd
APP_URL=http://localhost:3000
APP_MODE=demo
ENABLE_DEMO_LOGIN=true
COMMUNICATIONS_MODE=demo
# Set these to bootstrap a real administrator with npm run db:seed in APP_MODE=live.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Keep secrets server-side. Never use NEXT_PUBLIC_ for provider credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INTELLIGENCE_SERVICE_SID=
CALL_RECORDING_ENABLED=false
CALL_RECORDING_NOTICE=This call is being recorded for training and quality purposes.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_INBOUND_DOMAIN=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
# Live Sales Force origin: https://sales.linkd.com (local development stays localhost).
# Use a DIFFERENT random 32+ character key per website. The site's server uses
# the matching key as SALES_FORCE_SIGNING_KEY with SALES_FORCE_ENABLED=true.
INBOUND_JEWELLINK_SECRET=
INBOUND_LINKD_SECRET=
INBOUND_JEWELHIRE_SECRET=
INBOUND_COUNTRETAIL_SECRET=
# Calendly organization webhooks (invitee.created and invitee.canceled).
CALENDLY_SIGNING_KEY=
CALENDLY_ACCESS_TOKEN=
CALENDLY_ORGANIZATION_URI=
